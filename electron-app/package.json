{
  "name": "guardian-bar",
  "version": "1.0.0",
  "description": "Guardian Bar — Employee Incident Reporter",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"electron .\"",
    "build": "vite build && electron-builder",
    "start": "electron ."
  },
  "dependencies": {
    "axios": "^1.7.2",
    "framer-motion": "^11.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io-client": "^4.7.5",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "vite": "^5.3.4",
    "vite-plugin-electron": "^0.28.7"
  },
  "build": {
    "appId": "com.guardian.bar",
    "productName": "Guardian Bar",
    "win": { "target": "nsis" },
    "linux": { "target": "AppImage" }
  }
}
