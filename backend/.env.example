PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ---- MySQL ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=guardian
DB_PASS=guardian
DB_NAME=guardian_db

# ---- Scheduler ----
SCHEDULER_TIMEZONE=UTC
SLA_CRON=* * * * *
REPORT_CRON=0 5 1 * *
SLA_RUN_ON_START=false
REPORT_RUN_ON_START=false

# ---- Generated reports ----
REPORT_OUTPUT_DIR=./generated-reports

# ---- Collaboration webhooks ----
WEBHOOK_DISCORD_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
WEBHOOK_SLACK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
WEBHOOK_TEAMS_URL=https://outlook.office.com/webhook/YOUR_TEAMS_WEBHOOK

# ---- Email alerts (SMTP) ----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=guardian@example.com
SMTP_PASS=change_me
ALERT_EMAIL_FROM=guardian@example.com
ALERT_EMAIL_TO=mohammed.betkaoui@univ-bba.dz

# ---- SMS alerts (generic webhook provider) ----
SMS_WEBHOOK_URL=https://sms-provider.example.com/send
SMS_API_KEY=change_me
SMS_AUTH_HEADER=
SMS_FROM=Guardian
ALERT_SMS_TO=+213555000001,+213555000002

# ---- SIEM output ----
SIEM_ENDPOINT=https://siem.example.com/ingest
SIEM_TOKEN=change_me
SIEM_SOURCE=guardian

JWT_SECRET=change_me_in_production_use_long_random_string
