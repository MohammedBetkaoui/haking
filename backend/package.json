{
  "name": "guardian-backend",
  "version": "1.0.0",
  "description": "Guardian Incident Reporting Backend",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "db:migrate": "node src/db/migrate.js",
    "reports:generate": "node -e \"require('./src/services/reporting').generateMonthlyReport({ month: process.env.REPORT_MONTH }).then((report) => { console.log(JSON.stringify(report, null, 2)); process.exit(0); }).catch((err) => { console.error(err); process.exit(1); })\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "joi": "^17.13.1",
    "morgan": "^1.10.0",
    "mysql2": "^3.22.3",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.7",
    "pdfkit": "^0.15.2",
    "pg": "^8.12.0",
    "socket.io": "^4.7.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
